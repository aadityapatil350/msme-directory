generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Attribution
  source             String?
  utmSource          String?   @map("utm_source")
  utmMedium          String?   @map("utm_medium")
  utmCampaign        String?   @map("utm_campaign")
  utmTerm            String?   @map("utm_term")
  utmContent         String?   @map("utm_content")
  referrer           String?
  landingPage        String?   @map("landing_page")
  firstTouchSource   String?   @map("first_touch_source")
  lastTouchSource    String?   @map("last_touch_source")

  // Classification
  leadType           String    @map("lead_type") // loan_enquiry, scheme_enquiry, consultant_enquiry, newsletter
  schemeSlug         String?   @map("scheme_slug")
  loanSlug           String?   @map("loan_slug")

  // Contact
  fullName           String?   @map("full_name")
  phone              String?
  email              String?
  city               String?
  state              String?

  // Business Details
  businessName       String?   @map("business_name")
  sector             String?
  udyamStatus        String?   @map("udyam_status")
  turnoverBand       String?   @map("turnover_band")
  loanAmountNeeded   Float?    @map("loan_amount_needed")

  // DPDP Consent
  consentGiven       Boolean   @default(false) @map("consent_given")
  consentTextVersion String?   @map("consent_text_version")
  consentTimestamp   DateTime? @map("consent_timestamp")
  consentIp          String?   @map("consent_ip")
  marketingConsent   Boolean   @default(false) @map("marketing_consent")

  // Pipeline
  status             String    @default("new")
  notes              String?
  assignedTo         String?   @map("assigned_to")

  // Anti-Spam & Integrity
  isDuplicate        Boolean   @default(false) @map("is_duplicate")
  spamScore          Float?    @map("spam_score")

  @@index([createdAt])
  @@index([status])
  @@index([leadType])
  @@map("leads")
}
